# =============================================================================
#  Edge proxy rendered by the nginx role. Terminates client connections and
#  forwards everything to the dashboard container on the Docker network.
#  Managed by Ansible - do not edit on the node.
# =============================================================================
upstream crfd_dashboard {
    server {{ nginx_upstream_host }}:{{ nginx_upstream_port }};
    keepalive 16;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 8m;

    # Readiness probe used by the deployment pipeline.
    location = /healthz {
        proxy_pass http://crfd_dashboard{{ app_health_path }};
        access_log off;
    }

    location / {
        proxy_pass         http://crfd_dashboard;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }

    # Bulk event ingestion gets a little more headroom than the UI.
    location /api/v1/events/bulk {
        proxy_pass         http://crfd_dashboard;
        proxy_http_version 1.1;
        proxy_set_header   Host            $host;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_read_timeout 120s;
    }
}
